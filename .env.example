# ============================================================
#  Bulut Bilişim ve Yapay Zeka Teknolojileri — ortak .env
#  Bu dosyayı .env olarak kopyalayın:  cp .env.example .env
#  .env dosyası .gitignore'dadır; ASLA commit etmeyin.
# ============================================================

# ------------------------------------------------------------
# 1) Sohbet modeli — tek OpenAI uyumlu istemci, çok arka uç
#    Aşağıdaki bloklardan BİRİNİ açın (başındaki # işaretini kaldırın).
# ------------------------------------------------------------

# (a) Google AI Studio — kendi ücretsiz Gemini anahtarınız (aistudio.google.com)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=BURAYA_GEMINI_ANAHTARINIZ
LLM_MODEL=gemini-3.5-flash-lite

# (b) Azure AI Foundry — hocanın verdiği endpoint (ai.azure.com → Deployments → Endpoint)
#     Base URL'in sonunda /openai/v1/ olduğundan emin olun; model adı = deployment adı.
# LLM_BASE_URL=https://KAYNAK-ADI.openai.azure.com/openai/v1/
# LLM_API_KEY=HOCANIN_VERDIGI_ANAHTAR
# LLM_MODEL=gpt-6-luna

# (c) Ollama — yerel model, sıfır maliyet (ollama pull qwen3.5:4b)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3.5:4b

# (d) Sahte sunucu — ağ yokken ders için (python araclar/sahte_llm_sunucu.py)
# LLM_BASE_URL=http://localhost:8080/v1
# LLM_API_KEY=sahte
# LLM_MODEL=sahte-model

# Diğer ücretsiz seçenekler (aynı kalıp):
#   Groq        → https://api.groq.com/openai/v1          model: llama-4-scout
#   OpenRouter  → https://openrouter.ai/api/v1              model: <model>:free
#   DeepSeek    → https://api.deepseek.com/v1               model: deepseek-chat

# ------------------------------------------------------------
# 2) Gömme (embedding) modeli — week5 RAG
#    Boş bırakılırsa LLM_BASE_URL / LLM_API_KEY kullanılır.
# ------------------------------------------------------------
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=gemini-embedding-001
# Ollama için: EMBED_BASE_URL=http://localhost:11434/v1  EMBED_MODEL=bge-m3

# ------------------------------------------------------------
# 3) Opsiyonel servisler
# ------------------------------------------------------------
# week8 tracing (cloud.langfuse.com ücretsiz katman)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# week10 portfolyo kontrolü (public repolar için gerekmez; rate limit için işe yarar)
GITHUB_TOKEN=
