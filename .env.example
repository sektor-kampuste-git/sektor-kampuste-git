# ============================================================
#  Bulut Bilişim ve Yapay Zeka Teknolojileri — ortak .env
#  Bu dosyayı .env olarak kopyalayın:  cp .env.example .env
#  .env dosyası .gitignore'dadır; ASLA commit etmeyin.
# ============================================================

# ------------------------------------------------------------
# 1) Sohbet modeli — tek OpenAI uyumlu istemci, çok arka uç
#    Aşağıdaki bloklardan BİRİNİ açın (başındaki # işaretini kaldırın).
# ------------------------------------------------------------

# (a) Google AI Studio — kendi ücretsiz Gemini anahtarınız (aistudio.google.com)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=BURAYA_GEMINI_ANAHTARINIZ
LLM_MODEL=gemini-3.5-flash-lite

# (b) OpenRouter — hocanın size özel verdiği, harcama limitli anahtar (sk-or-v1-...)
#     Tek endpoint, bütün modeller: model adı "sağlayıcı/model" biçimindedir.
#     Ucuz: openai/gpt-6-luna · deepseek/deepseek-v4.1-flash   Hakem: anthropic/claude-opus-5.5
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=HOCANIN_VERDIGI_ANAHTAR
# LLM_MODEL=openai/gpt-6-luna

# (c) Ollama — yerel model, sıfır maliyet (ollama pull qwen3.5:4b)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3.5:4b

# (d) Sahte sunucu — ağ yokken ders için (python araclar/sahte_llm_sunucu.py)
# LLM_BASE_URL=http://localhost:8080/v1
# LLM_API_KEY=sahte
# LLM_MODEL=sahte-model

# Diğer ücretsiz seçenekler (aynı kalıp):
#   Groq        → https://api.groq.com/openai/v1          model: llama-4-scout
#   OpenRouter  → kendi ücretsiz hesabınızla da olur        model: <model>:free (günde 50 istek)
#   DeepSeek    → https://api.deepseek.com/v1               model: deepseek-chat

# ------------------------------------------------------------
# 2) Gömme (embedding) modeli — week5 RAG
#    Boş bırakılırsa LLM_BASE_URL / LLM_API_KEY kullanılır.
# ------------------------------------------------------------
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=gemini-embedding-001
# Ollama için: EMBED_BASE_URL=http://localhost:11434/v1  EMBED_MODEL=bge-m3

# ------------------------------------------------------------
# 3) Opsiyonel servisler
# ------------------------------------------------------------
# week8 tracing (cloud.langfuse.com ücretsiz katman)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# week10 portfolyo kontrolü (public repolar için gerekmez; rate limit için işe yarar)
GITHUB_TOKEN=

# ------------------------------------------------------------
# 4) Hafta 1-3 kodunun eski değişken adları (isteğe bağlı)
#    week1-3 betikleri önce yukarıdaki LLM_* değişkenlerini okur; bunlar boşsa
#    derste gösterilen eski adlara düşer. İkisini birden doldurmanız gerekmez.
# ------------------------------------------------------------
# GEMINI_API_KEY=           # week1/hello.py, week2/temperature.py (LLM_API_KEY boşsa)
# GEMINI_MODEL=gemini-3.5-flash
# OLLAMA_BASE_URL=http://localhost:11434/v1   # week1/hello.py, week2/bakeoff.py
# BASE_URL= / API_KEY= / MODEL=               # week3/extract.py ve extract.ts (LLM_* boşsa)
# GROQ_API_KEY= / OPENROUTER_API_KEY=         # week1/hello.py içindeki yorumlu satırlar
